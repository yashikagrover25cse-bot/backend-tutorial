{"info":{"description":"Step (e): import into Postman Desktop, set base_url to http://localhost:3000, run in order. After POST, copy the returned _id into the :id requests.","name":"Backend Tutorial — Subscribers CRUD"},"item":[{"name":"GET all subscribers","request":{"method":"GET","url":"{{base_url}}/subscribers"}},{"name":"POST create subscriber","request":{"body":{"mode":"raw","raw":"{\n  \"name\": \"Your Name\",\n  \"subscribedToChannel\": \"Backend Tutorial\"\n}"},"header":[{"key":"Content-Type","value":"application/json"}],"method":"POST","url":"{{base_url}}/subscribers"}},{"name":"GET one subscriber","request":{"method":"GET","url":"{{base_url}}/subscribers/:id"}},{"name":"PATCH update subscriber","request":{"body":{"mode":"raw","raw":"{\n  \"name\": \"Updated Name\"\n}"},"header":[{"key":"Content-Type","value":"application/json"}],"method":"PATCH","url":"{{base_url}}/subscribers/:id"}},{"name":"DELETE subscriber","request":{"method":"DELETE","url":"{{base_url}}/subscribers/:id"}}],"variable":[{"key":"base_url","value":"http://localhost:3000"}]}