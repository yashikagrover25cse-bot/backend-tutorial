# Copy this file to .env and fill in your own MongoDB Atlas URI.
# NEVER commit a real .env — it is in .gitignore for that reason.
# Atlas example (replace <username>, <password>, <cluster>):
# DATABASE_URL=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/subscribers?retryWrites=true&w=majority
DATABASE_URL=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/subscribers?retryWrites=true&w=majority
PORT=3000
